{
  "name": "@ftod/verdict",
  "version": "0.1.0",
  "description": "Honest dependency linting. Reads your package.json and tells you the truth about every dependency.",
  "main": "dist/index.js",
  "bin": {
    "verdict": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node18 --outfile=dist/index.js --format=cjs --banner:js='#!/usr/bin/env node'",
    "dev": "vitest",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "dependencies",
    "lint",
    "package.json",
    "bundle-size",
    "cli"
  ],
  "author": "Shashank",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "esbuild": "^0.21.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@types/node": "^20.0.0"
  }
}
